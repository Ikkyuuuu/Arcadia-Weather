<Window x:Class="ArcadiaWeather.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:ArcadiaWeather.Presentation" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Arcadia Weather" Width="1280" Height="860" MinWidth="720" MinHeight="620" WindowStartupLocation="CenterScreen" Icon="Assets/butterfly.png"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SizeChanged="Window_SizeChanged" ui:Motion.Enabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Template><ControlTemplate TargetType="Window"><Border Background="{TemplateBinding Background}"><AdornerDecorator><ContentPresenter/></AdornerDecorator></Border></ControlTemplate></Window.Template>
  <Grid x:Name="WindowContent">
    <!-- Full-width brand bar. The TabControl's header shares this row. -->
    <Border Height="56" VerticalAlignment="Top" Background="#36BBD9" IsHitTestVisible="False"/>
    <Grid Height="56" VerticalAlignment="Top" Panel.ZIndex="1">
      <Grid Margin="20,0,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Image Source="Assets/butterfly.png" Width="34" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Arcadia Weather butterfly"/><TextBlock x:Name="BrandText" Text="Arcadia Weather" FontSize="17" FontWeight="SemiBold" Foreground="#06272F" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <CheckBox x:Name="DarkModeToggle" Content="Dark mode" Width="118" Style="{StaticResource NavbarThemeToggle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Checked="DarkMode_Changed" Unchecked="DarkMode_Changed" ToolTip="Switch light or dark appearance. Saved automatically." AutomationProperties.Name="Dark mode, saved automatically" Margin="0,0,16,0"/>
          <Grid Width="96" Margin="0,0,12,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse x:Name="ModeDot" Width="6" Height="6" Fill="#06272F" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="ModeBadge" Text="Automatic" Foreground="#06272F" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/></Grid>
          <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize window"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize window"><TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
          <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Close to tray" AutomationProperties.Name="Close window to tray"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/></Button>
        </StackPanel>
      </Grid>
    </Grid>
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
      <TabItem x:Name="BayTab" Header="Wallpaper">
        <Grid x:Name="WallpaperViewport" SizeChanged="WallpaperViewport_SizeChanged" ClipToBounds="True">
          <Grid x:Name="BayPage" Margin="28,24" MaxWidth="1360">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="ErrorBanner" Background="{DynamicResource HoldSoftBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,20" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource HoldBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
            <Grid x:Name="DashboardGrid" Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition x:Name="DashboardGap" Width="40"/><ColumnDefinition x:Name="WeatherColumn" Width="310"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid x:Name="StagePanel">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="HeroSection" MinHeight="0" CornerRadius="18" Background="#0B1012" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                  <Grid x:Name="HeroViewport" SizeChanged="RoundedSurface_SizeChanged">
                    <Image x:Name="HeroPreviousImage" Stretch="UniformToFill"/><Image x:Name="HeroImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <MediaElement x:Name="HeroVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" MediaOpened="Preview_Opened" MediaEnded="Preview_Ended" MediaFailed="Preview_Failed"/>
                    <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0004080A" Offset="0.45"/><GradientStop Color="#B004080A" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                    <Border x:Name="PausedBadge" Visibility="Collapsed" Background="#B004080A" CornerRadius="16" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"><TextBlock x:Name="PausedBadgeText" Text="Paused" Foreground="White" FontSize="12"/></Border>
                    <StackPanel x:Name="HeroCopy" VerticalAlignment="Bottom" Margin="24"><TextBlock Text="ON YOUR DESKTOP" FontSize="11" FontWeight="SemiBold" Foreground="#D6FFFFFF" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="SceneEyebrow" Text="Day 1" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock Text=" · " Foreground="#BFFFFFFF" FontSize="25"/><TextBlock x:Name="SceneTitle" FontSize="25" FontWeight="SemiBold" Foreground="White"/></StackPanel></StackPanel>
                  </Grid>
                </Border>
                <Border x:Name="TransportBar" Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,12,0,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <Button x:Name="PauseButton" Click="Pause_Click" Style="{StaticResource RoundPlaybackButton}" ToolTip="Pause wallpaper" AutomationProperties.Name="Pause wallpaper"><TextBlock x:Name="PauseGlyph" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                    <Button Grid.Column="1" x:Name="MuteButton" Click="Mute_Click" Style="{StaticResource IconButton}" Margin="8,0,0,0" AutomationProperties.Name="Unmute wallpaper"><TextBlock x:Name="MuteGlyph" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="19"/></Button>
                    <Slider Grid.Column="2" x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0" ValueChanged="Volume_Changed" AutomationProperties.Name="Wallpaper volume"/>
                    <TextBlock Grid.Column="3" x:Name="VolumeText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="4" x:Name="UpdateText" Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0"/>
                    <Button Grid.Column="5" x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource IconButton}" ToolTip="Check weather now" AutomationProperties.Name="Check weather now"><TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform x:Name="RefreshRotation"/></TextBlock.RenderTransform></TextBlock></Button>
                  </Grid>
                </Border>
                <TextBlock Grid.Row="2" x:Name="PlaybackText" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="2,8,0,0"/>
              </Grid>
              <Viewbox x:Name="WeatherViewport" Grid.Column="2" Grid.RowSpan="2" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
              <StackPanel x:Name="NowPanel" Width="310">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/><TextBlock Grid.Column="1" x:Name="HeaderLocation" FontSize="19" FontWeight="SemiBold"/></Grid>
                <WrapPanel Margin="25,6,0,0"><TextBlock x:Name="CoordinatesText" FontSize="11" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/><Button Content="Change" Click="ChangeLocation_Click" Style="{StaticResource QuietButton}" Foreground="{DynamicResource AccentBrush}" Padding="8,3" MinHeight="28"/></WrapPanel>
                <Grid Margin="0,28,0,0"><TextBlock x:Name="TemperatureText" Text="—°" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="68" FontWeight="Medium"/><Viewbox Width="56" Height="56" HorizontalAlignment="Right" VerticalAlignment="Center"><Path x:Name="WeatherIcon" Data="{StaticResource SunIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Grid>
                <TextBlock x:Name="ConditionText" Text="Checking the weather…" FontSize="18" FontWeight="Medium" Margin="0,2,0,0"/>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0"><UniformGrid Columns="3"><StackPanel><TextBlock Text="Feels like" Style="{StaticResource MetaLabel}"/><TextBlock x:Name="FeelsLikeText" Text="—" FontSize="15" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="Humidity" Style="{StaticResource MetaLabel}"/><TextBlock x:Name="HumidityText" Text="—" FontSize="15" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="Local time" Style="{StaticResource MetaLabel}"/><TextBlock x:Name="HeaderClock" Text="—" FontSize="15" Margin="0,5,0,0"/></StackPanel></UniformGrid></Border>
                <TextBlock Text="Weather by Open-Meteo · updated every 5 minutes" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,17,0,0"/>
                <TextBlock Text="Scene selection" FontSize="13" FontWeight="SemiBold" Margin="0,30,0,12"/>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                  <Grid x:Name="ModeSelector" SizeChanged="ModeSelector_SizeChanged">
                    <Border x:Name="ModeIndicator" Width="0" HorizontalAlignment="Left" Background="{DynamicResource PanelBrush}" CornerRadius="6" IsHitTestVisible="False"/>
                    <UniformGrid Columns="2"><Button x:Name="AutoButton" Content="Automatic" Click="Auto_Click" Style="{StaticResource SegmentButton}"/><Button x:Name="ManualButton" Content="Manual" Click="Manual_Click" Style="{StaticResource SegmentButton}"/></UniformGrid>
                  </Grid>
                </Border>
                <TextBlock x:Name="ModeReason" Text="Following the weather and local time." Foreground="{DynamicResource MutedBrush}" FontSize="13" Height="48" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                <Border x:Name="HoldNote" Height="92" Background="{DynamicResource HoldSoftBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0" Visibility="Hidden"><StackPanel><TextBlock x:Name="HoldText" Foreground="{DynamicResource HoldBrush}" FontSize="12"/><Button Content="Return to Automatic" Click="Auto_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Foreground="{DynamicResource HoldBrush}" Padding="0,10,0,0"/></StackPanel></Border>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><TextBlock Text="Clouds " Style="{StaticResource MetaLabel}"/><TextBlock x:Name="CloudText" Style="{StaticResource MetaLabel}"/><TextBlock Text="  ·  Sunset " Style="{StaticResource MetaLabel}"/><TextBlock x:Name="SunsetText" Style="{StaticResource MetaLabel}"/></StackPanel>
              </StackPanel>
              </Viewbox>
              <StackPanel x:Name="ScenesPanel" Grid.Row="1" Margin="0,22,0,0"><DockPanel Margin="0,0,0,16"><TextBlock Text="Scenes" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ScenesHint" Text="Pick a scene to hold it on your desktop." Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel><UniformGrid x:Name="SceneCards" Columns="5"/></StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="SettingsTab" Header="Settings">
        <Grid x:Name="SettingsPage" Margin="32,28,32,20" MaxWidth="1120">
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsIndexColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="SettingsIndex" Margin="0,0,32,0"><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/><Button Content="Location" Tag="LocationSection" Click="SettingsJump_Click" Style="{StaticResource IndexButton}"/><Button Content="Display" Tag="DisplaySection" Click="SettingsJump_Click" Style="{StaticResource IndexButton}"/><Button Content="Windows" Tag="WindowsSection" Click="SettingsJump_Click" Style="{StaticResource IndexButton}"/><Button Content="About / scene rules" Click="About_Click" Style="{StaticResource IndexButton}" FontSize="12" Margin="0,24,0,0"/></StackPanel>
            <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,10,0">
                <StackPanel x:Name="LocationSection" Focusable="True"><TextBlock Text="Location" Style="{StaticResource SectionTitle}"/><TextBlock Text="Weather for this place picks the scene." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,8,0,18"/>
                  <Border Style="{StaticResource SettingsPanel}"><StackPanel>
                    <TextBlock Text="City or district" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CitySearch" AutomationProperties.Name="Search city or district" KeyDown="CitySearch_KeyDown" ToolTip="Type a city or district, then press Enter"/><Button x:Name="SearchButton" Grid.Column="1" Content="Search" Margin="8,0,0,0" Click="Search_Click"/></Grid>
                    <TextBlock Text="Search by name, or enter coordinates below." Style="{StaticResource MetaLabel}" Margin="0,7,0,0"/>
                    <ComboBox x:Name="CityResults" Margin="0,10,0,0" SelectionChanged="City_SelectionChanged" AutomationProperties.Name="Matching cities and districts"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="HasItems" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                    <TextBlock Text="Location name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LocationNameInput" AutomationProperties.Name="Location name"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Latitude" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LatitudeInput" AutomationProperties.Name="Latitude, minus 90 to 90"/><TextBlock Text="−90 to 90" Style="{StaticResource MetaLabel}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Longitude" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LongitudeInput" AutomationProperties.Name="Longitude, minus 180 to 180"/><TextBlock Text="−180 to 180" Style="{StaticResource MetaLabel}" Margin="0,6,0,0"/></StackPanel></Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="UseLocationButton" Content="Use my location" Click="UseLocation_Click"/><Button x:Name="CancelLocationButton" Content="Cancel" Click="CancelLocation_Click" Margin="8,0,0,0" Visibility="Collapsed"/><Grid x:Name="LocationActivity" Width="16" Height="16" Margin="12,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Finding your location"><Path Data="M 8,1 A 7,7 0 1 1 1,8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="LocationRotation"/></Path.RenderTransform></Path></Grid></StackPanel>
                    <TextBlock Text="Uses Windows location services, with your permission." Style="{StaticResource MetaLabel}" Margin="0,8,0,0"/><TextBlock x:Name="LocationStatusText" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/><Button x:Name="LocationSettingsButton" Content="Windows location settings" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="LocationSettings_Click"/>
                    <TextBlock Text="Timezone" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TimezoneInput" AutomationProperties.Name="Location timezone"/>
                  </StackPanel></Border>
                  <Border Style="{StaticResource SettingsPanel}" Margin="0,14,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="Temperature" VerticalAlignment="Center"/><ListBox Style="{StaticResource SegmentedPicker}" x:Name="UnitInput" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="Temperature unit"><ListBoxItem Content="°C" Tag="C"/><ListBoxItem Content="°F" Tag="F"/></ListBox></Grid><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,18,0,0"><DockPanel><TextBlock Text="Weather updates"/><TextBlock Text="Every 5 minutes" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel></Border></StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="DisplaySection" Margin="0,34,0,0" Focusable="True"><TextBlock Text="Display" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/><Border Style="{StaticResource SettingsPanel}"><StackPanel>
                  <TextBlock Text="Show wallpaper on" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/><ComboBox x:Name="MonitorInput" DisplayMemberPath="Label" SelectedValuePath="Device" AutomationProperties.Name="Wallpaper display"/>
                  <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fit"/><TextBlock Text="Fill crops to cover the screen." Style="{StaticResource MetaLabel}" Margin="0,5,12,0"/></StackPanel><ListBox Style="{StaticResource SegmentedPicker}" x:Name="FitInput" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="Wallpaper fit"><ListBoxItem Content="Fill" Tag="fill"/><ListBoxItem Content="Fit" Tag="fit"/></ListBox></Grid>
                  <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="App theme" VerticalAlignment="Center"/><ListBox Style="{StaticResource SegmentedPicker}" x:Name="ThemeInput" SelectionChanged="Theme_SelectionChanged" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="App theme"><ListBoxItem Content="System" Tag="system"/><ListBoxItem Content="Light" Tag="light"/><ListBoxItem Content="Dark" Tag="dark"/></ListBox></Grid>
                </StackPanel></Border></StackPanel>
                <StackPanel x:Name="WindowsSection" Margin="0,34,0,0" Focusable="True"><TextBlock Text="Windows" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/><Border Style="{StaticResource SettingsPanel}"><StackPanel><CheckBox x:Name="StartupInput" Content="Start with Windows"/><TextBlock Text="Opens in the tray when you sign in." Style="{StaticResource MetaLabel}" Margin="0,3,0,20"/><CheckBox x:Name="FullScreenInput" Content="Pause during fullscreen apps"/><TextBlock Text="Resumes when you leave the game or video." Style="{StaticResource MetaLabel}" Margin="0,3,0,0"/></StackPanel></Border></StackPanel>
                <Expander Header="Advanced scene timing" Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,28,0,18"><StackPanel Margin="0,10,0,0"><UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="Clouds enter at (%)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CloudEnterInput" AutomationProperties.Name="Cloud enter threshold"/></StackPanel><StackPanel><TextBlock Text="Clouds clear at (%)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CloudExitInput" AutomationProperties.Name="Cloud clearing threshold"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Evening · minutes before sunset" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EveningInput" AutomationProperties.Name="Evening minutes before sunset"/></StackPanel><StackPanel><TextBlock Text="Night · minutes after sunset" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NightInput" AutomationProperties.Name="Night minutes after sunset"/></StackPanel></UniformGrid></StackPanel></Expander>
                <Button Content="About Arcadia Weather and scene rules" Click="About_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="SettingsMessage" Foreground="{DynamicResource AccentBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Theme saves automatically. Save to apply other changes." Style="{StaticResource MetaLabel}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="RevertButton" Content="Revert" Click="Revert_Click" Style="{StaticResource QuietButton}" Margin="0,0,12,0"/><Button Grid.Column="2" x:Name="SaveButton" Content="Save settings" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="22,12"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="AboutTab" Header="About" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GuidePage" MaxWidth="780" Margin="32" HorizontalAlignment="Left">
          <Button Content="←  Settings" Click="ChangeLocation_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,0,0,20"/><TextBlock Text="Scene rules" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,22"/>
          <TextBlock FontSize="15" LineHeight="28" Text="Day 1 · Morning and afternoon, beginning at sunrise.&#10;Day 4 · Evening, beginning one hour before sunset.&#10;Day 3 · Night, beginning 30 minutes after sunset.&#10;Day 2 · Cloudy skies replace daylight and evening, never night.&#10;Day 5 · Rain, drizzle, showers, and storms replace every scene."/>
          <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="14" LineHeight="25" Margin="0,26,0,0" Text="Weather refreshes every five minutes. Select a scene to hold it until you select Automatic again. Timing follows sunrise and sunset for your location, with adjustments in advanced settings.&#10;&#10;When weather cannot be refreshed, recent conditions are retained for up to an hour. Then the app follows time of day. Without solar data it uses 06:00 / 17:00 / 19:00 in the selected timezone.&#10;&#10;The preview loops a short excerpt of the active scene. Desktop playback uses the full bundled video. System reduced-motion preferences disable animated previews and interface transitions.&#10;&#10;Closing the window keeps your wallpaper running in the tray. Use Exit to stop the app."/>
          <TextBlock Foreground="{DynamicResource SubtleBrush}" FontSize="12" Margin="0,24,0,0">Weather: <Hyperlink NavigateUri="https://open-meteo.com/" RequestNavigate="Link_Navigate">Open-Meteo</Hyperlink> · CC BY 4.0. Playback: LibVLC / LibVLCSharp.&#10;An unofficial personal project using bundled Life is Strange scenes.</TextBlock>
          <WrapPanel Margin="0,24,0,0"><Button Content="Open app data and logs" Click="Logs_Click" Margin="0,0,12,12"/><Button Content="Exit Arcadia Weather" Click="Exit_Click" Margin="0,0,0,12"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
